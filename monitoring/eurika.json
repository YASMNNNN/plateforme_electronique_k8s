{
  "title": "Plateforme - Eureka Server",
  "uid": "plateforme-eureka-001",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["plateforme", "eureka", "docker"],
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "constant",
        "current": { "value": "plateforme-eureka" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Container Status",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "container_last_seen{name=\"plateforme-eureka\"}",
          "legendFormat": "Eureka"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "time() - container_start_time_seconds{name=\"plateforme-eureka\"}",
          "legendFormat": "Uptime"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU Usage",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 80 }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_cpu_usage_seconds_total{name=\"plateforme-eureka\"}[2m]) * 100",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory Usage",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 400000000 }, { "color": "red", "value": 700000000 }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "container_memory_working_set_bytes{name=\"plateforme-eureka\"}",
          "legendFormat": "Memory"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Memory Limit",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "container_spec_memory_limit_bytes{name=\"plateforme-eureka\"}",
          "legendFormat": "Limit"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Restarts",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "container_oom_events_total{name=\"plateforme-eureka\"}",
          "legendFormat": "OOM Events"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU Usage Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 80 }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_cpu_usage_seconds_total{name=\"plateforme-eureka\"}[2m]) * 100",
          "legendFormat": "CPU Usage %"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory Usage Over Time",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "container_memory_working_set_bytes{name=\"plateforme-eureka\"}",
          "legendFormat": "Working Set"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "container_memory_rss{name=\"plateforme-eureka\"}",
          "legendFormat": "RSS"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "container_memory_cache{name=\"plateforme-eureka\"}",
          "legendFormat": "Cache"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Network I/O (bytes/sec)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_network_receive_bytes_total{name=\"plateforme-eureka\"}[2m])",
          "legendFormat": "RX (received)"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_network_transmit_bytes_total{name=\"plateforme-eureka\"}[2m])",
          "legendFormat": "TX (transmitted)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Disk I/O (bytes/sec)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_fs_reads_bytes_total{name=\"plateforme-eureka\"}[2m])",
          "legendFormat": "Read"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_fs_writes_bytes_total{name=\"plateforme-eureka\"}[2m])",
          "legendFormat": "Write"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Network Errors & Dropped Packets",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_network_receive_errors_total{name=\"plateforme-eureka\"}[2m])",
          "legendFormat": "RX Errors"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_network_transmit_errors_total{name=\"plateforme-eureka\"}[2m])",
          "legendFormat": "TX Errors"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "rate(container_network_receive_packets_dropped_total{name=\"plateforme-eureka\"}[2m])",
          "legendFormat": "RX Dropped"
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Eureka Logs (Loki)",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "{container_name=\"plateforme-eureka\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
